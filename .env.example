# Copy this file to `.env` and fill in your own value.

# From https://developer.spotify.com/dashboard -> your app -> Settings
VITE_SPOTIFY_CLIENT_ID=

# Must match EXACTLY one of the Redirect URIs registered on your Spotify app.
# Note: 127.0.0.1, not localhost — Spotify rejects `localhost` now.
VITE_REDIRECT_URI=http://127.0.0.1:5173/callback
